{
  "network": {
    "wsPort": 8500,
    "httpPort": 8501,
    "adbExecutable": "adb",
    "reversePollMs": 10000
  },
  "autoUnlock": {
    "enabled": true,
    "wirelessEnabled": false,
    "wirelessEndpoint": "",
    "wirelessMdnsAutoDiscover": true,
    "triggerMode": "on_connect",
    "password": "",
    "swipeToUnlock": true,
    "launchApp": true,
    "packageName": "com.phoneconsole.client",
    "activityName": "com.phoneconsole.client.MainActivity"
  },
  "screen": {
    "ffmpegExecutable": "ffmpeg",
    "monitor": -1,
    "maxWidth": 1280,
    "maxHeight": 720,
    "usbFps": 30,
    "lanFps": 24,
    "maxBitrateKbps": 3000,
    "scaleFlags": "fast_bilinear",
    "x264Preset": "ultrafast",
    "x264Threads": 0
  },
  "camera": {
    "enabled": true,
    "rtspPort": 8554,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "bitrateKbps": 4000,
    "autoDemand": true,
    "facing": "front",
    "rotation": 0,
    "mirrorHorizontal": false,
    "mirrorVertical": false
  },
  "defaultPageId": "default_page",
  "pages": [
    {
      "id": "default_page",
      "title": "通用控制",
      "grid": { "rows": 3, "cols": 3 },
      "buttons": [
        {
          "id": "btn_mute",
          "label": "静音",
          "icon": "",
          "bgColor": "#1E293B",
          "state": "normal",
          "action": {
            "type": "media",
            "command": "mute",
            "toggle": true,
            "activeState": "muted",
            "activeLabel": "已静音",
            "activeIcon": "",
            "activeBgColor": "#7F1D1D"
          }
        },
        {
          "id": "btn_vol_down",
          "label": "音量 -",
          "icon": "",
          "bgColor": "#1E293B",
          "state": "normal",
          "action": { "type": "media", "command": "volume_down" }
        },
        {
          "id": "btn_vol_up",
          "label": "音量 +",
          "icon": "",
          "bgColor": "#1E293B",
          "state": "normal",
          "action": { "type": "media", "command": "volume_up" }
        },
        {
          "id": "btn_prev",
          "label": "上一首",
          "icon": "",
          "bgColor": "#0F172A",
          "state": "normal",
          "action": { "type": "media", "command": "prev" }
        },
        {
          "id": "btn_play",
          "label": "播放 / 暂停",
          "icon": "",
          "bgColor": "#0F172A",
          "state": "normal",
          "action": { "type": "media", "command": "play_pause" }
        },
        {
          "id": "btn_next",
          "label": "下一首",
          "icon": "",
          "bgColor": "#0F172A",
          "state": "normal",
          "action": { "type": "media", "command": "next" }
        },
        {
          "id": "btn_taskmgr",
          "label": "任务管理器",
          "icon": "",
          "bgColor": "#134E4A",
          "state": "normal",
          "action": { "type": "hotkey", "keys": ["ctrl", "shift", "esc"] }
        },
        {
          "id": "btn_alt_tab",
          "label": "切换窗口",
          "icon": "",
          "bgColor": "#134E4A",
          "state": "normal",
          "action": { "type": "hotkey", "keys": ["alt", "tab"] }
        },
        {
          "id": "btn_notepad",
          "label": "记事本",
          "icon": "",
          "bgColor": "#134E4A",
          "state": "normal",
          "action": { "type": "launch", "target": "notepad.exe" }
        }
      ]
    },
    {
      "id": "ide_page",
      "title": "开发模式",
      "grid": { "rows": 2, "cols": 3 },
      "buttons": [
        {
          "id": "ide_run",
          "label": "运行",
          "icon": "",
          "bgColor": "#1E293B",
          "state": "normal",
          "action": { "type": "hotkey", "keys": ["ctrl", "f5"] }
        },
        {
          "id": "ide_stop",
          "label": "停止",
          "icon": "",
          "bgColor": "#1E293B",
          "state": "normal",
          "action": { "type": "hotkey", "keys": ["shift", "f5"] }
        },
        {
          "id": "ide_terminal",
          "label": "终端",
          "icon": "",
          "bgColor": "#0F172A",
          "state": "normal",
          "action": { "type": "hotkey", "keys": ["alt", "f12"] }
        },
        {
          "id": "ide_format",
          "label": "格式化代码",
          "icon": "",
          "bgColor": "#0F172A",
          "state": "normal",
          "action": { "type": "hotkey", "keys": ["ctrl", "alt", "l"] }
        },
        {
          "id": "ide_browser",
          "label": "打开浏览器",
          "icon": "",
          "bgColor": "#134E4A",
          "state": "normal",
          "action": { "type": "url", "target": "https://www.google.com" }
        }
      ]
    }
  ],
  "appBindings": [
    { "process": "idea64.exe", "pageId": "ide_page" },
    { "process": "code.exe", "pageId": "ide_page" },
    { "process": "chrome.exe", "pageId": "default_page" },
    { "process": "msedge.exe", "pageId": "default_page" },
    { "process": "vlc.exe", "pageId": "default_page" }
  ]
}
