<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView style="@style/CardTitle" android:text="CPU 占用 · 近 60 秒" />

                <TextView
                    android:id="@+id/cpu_big"
                    style="@style/CardValue"
                    android:text="--%" />

                <com.phoneconsole.client.ui.HistoryGraphView
                    android:id="@+id/cpu_graph"
                    android:layout_width="match_parent"
                    android:layout_height="60dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView style="@style/CardTitle" android:text="内存占用 · 近 60 秒" />

                <TextView
                    android:id="@+id/mem_big"
                    style="@style/CardValue"
                    android:text="--%" />

                <com.phoneconsole.client.ui.HistoryGraphView
                    android:id="@+id/mem_graph"
                    android:layout_width="match_parent"
                    android:layout_height="60dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_weight="1">

                <TextView style="@style/CardTitle" android:text="GPU 占用 · 近 60 秒" />

                <TextView
                    android:id="@+id/gpu_big"
                    style="@style/CardValue"
                    android:text="--%" />

                <com.phoneconsole.client.ui.HistoryGraphView
                    android:id="@+id/gpu_graph"
                    android:layout_width="match_parent"
                    android:layout_height="60dp" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card"
                android:layout_width="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="系统音量" />

                    <TextView
                        android:id="@+id/mute_state"
                        style="@style/CardTitle"
                        android:text="--" />
                </LinearLayout>

                <TextView
                    android:id="@+id/vol_big"
                    style="@style/CardValue"
                    android:text="--%" />

                <ProgressBar
                    android:id="@+id/vol_big_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="100"
                    android:progressBackgroundTint="#1E293B"
                    android:progressTint="#A78BFA" />

                <TextView
                    android:id="@+id/net_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="↑ 0 B/s · ↓ 0 B/s"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
