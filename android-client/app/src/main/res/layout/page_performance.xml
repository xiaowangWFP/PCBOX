<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="@dimen/page_padding_h"
    android:paddingTop="@dimen/page_padding_v"
    android:paddingEnd="@dimen/page_padding_h"
    android:paddingBottom="@dimen/page_padding_v">

    <!-- 竖屏：2 列 × 3 行紧凑 KPI 卡片（数值 + 右上环形 + 底部细进度条） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="硬件实时遥测"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每秒同步"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 第 1 行：CPU + 内存 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/ConsoleCard"
                android:layout_width="0dp"
                android:layout_height="@dimen/perf_card_height"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPU 占用"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvCpuValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="--%"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/kpi_value_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.phoneconsole.client.ui.RingProgressView
                        android:id="@+id/ringCpu"
                        android:layout_width="@dimen/perf_ring_size"
                        android:layout_height="@dimen/perf_ring_size"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/barCpu"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/perf_bar_height"
                    android:max="100"
                    android:maxHeight="@dimen/perf_bar_height"
                    android:minHeight="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="@color/divider_line"
                    android:progressTint="@color/accent_blue" />
            </LinearLayout>

            <LinearLayout
                style="@style/ConsoleCard"
                android:layout_width="0dp"
                android:layout_height="@dimen/perf_card_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="内存占用"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvMemValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="--%"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/kpi_value_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.phoneconsole.client.ui.RingProgressView
                        android:id="@+id/ringMem"
                        android:layout_width="@dimen/perf_ring_size"
                        android:layout_height="@dimen/perf_ring_size"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/barMem"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/perf_bar_height"
                    android:max="100"
                    android:maxHeight="@dimen/perf_bar_height"
                    android:minHeight="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="@color/divider_line"
                    android:progressTint="@color/status_ok" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 2 行：GPU + 显存 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/ConsoleCard"
                android:layout_width="0dp"
                android:layout_height="@dimen/perf_card_height"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GPU 占用"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvGpuValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="—"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/kpi_value_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.phoneconsole.client.ui.RingProgressView
                        android:id="@+id/ringGpu"
                        android:layout_width="@dimen/perf_ring_size"
                        android:layout_height="@dimen/perf_ring_size"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/barGpu"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/perf_bar_height"
                    android:max="100"
                    android:maxHeight="@dimen/perf_bar_height"
                    android:minHeight="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="@color/divider_line"
                    android:progressTint="@color/status_warn" />
            </LinearLayout>

            <LinearLayout
                style="@style/ConsoleCard"
                android:layout_width="0dp"
                android:layout_height="@dimen/perf_card_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="显存占用"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvVramValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/kpi_value_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.phoneconsole.client.ui.RingProgressView
                        android:id="@+id/ringVram"
                        android:layout_width="@dimen/perf_ring_size"
                        android:layout_height="@dimen/perf_ring_size"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/barVram"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/perf_bar_height"
                    android:max="100"
                    android:maxHeight="@dimen/perf_bar_height"
                    android:minHeight="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="@color/divider_line"
                    android:progressTint="@color/accent_bright" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第 3 行：画面帧率 + 系统音量 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/ConsoleCard"
                android:layout_width="0dp"
                android:layout_height="@dimen/perf_card_height"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="画面帧率"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tvFpsValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/kpi_value_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.phoneconsole.client.ui.RingProgressView
                        android:id="@+id/ringFps"
                        android:layout_width="@dimen/perf_ring_size"
                        android:layout_height="@dimen/perf_ring_size"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <ProgressBar
                    android:id="@+id/barFps"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/perf_bar_height"
                    android:max="100"
                    android:maxHeight="@dimen/perf_bar_height"
                    android:minHeight="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="@color/divider_line"
                    android:progressTint="@color/perf_cyan" />
            </LinearLayout>

            <LinearLayout
                style="@style/ConsoleCard"
                android:layout_width="0dp"
                android:layout_height="@dimen/perf_card_height"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="系统音量"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvVolValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="--%"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/kpi_value_text"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvVolSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="正常"
                                android:textColor="@color/text_muted"
                                android:textSize="10.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.phoneconsole.client.ui.RingProgressView
                        android:id="@+id/ringVol"
                        android:layout_width="@dimen/perf_ring_size"
                        android:layout_height="@dimen/perf_ring_size"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginBottom="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPerfVolDown"
                        style="@style/ConsoleGhostButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:minHeight="28dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="−"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnPerfMute"
                        style="@style/ConsoleGhostButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1.2"
                        android:minHeight="28dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="静音"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/btnPerfVolUp"
                        style="@style/ConsoleGhostButton"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:minHeight="28dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:text="+"
                        android:textSize="12sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/barVol"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/perf_bar_height"
                    android:max="100"
                    android:maxHeight="@dimen/perf_bar_height"
                    android:minHeight="0dp"
                    android:progress="0"
                    android:progressBackgroundTint="@color/divider_line"
                    android:progressTint="@color/status_purple" />
            </LinearLayout>
        </LinearLayout>

        <!-- 网络实时吞吐条 -->
        <LinearLayout
            style="@style/ConsoleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="网络实时吞吐"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/tvNetUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:fontFamily="monospace"
                android:text="↑ --"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNetDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="↓ --"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
