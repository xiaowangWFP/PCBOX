<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding_h"
    android:paddingTop="@dimen/page_padding_v"
    android:paddingEnd="@dimen/page_padding_h"
    android:paddingBottom="@dimen/page_padding_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnToggleStream"
            style="@style/ConsolePrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开始监视" />

        <Spinner
            android:id="@+id/spinnerMonitors"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:minWidth="96dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <TextView
            android:id="@+id/tvScreenMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:maxWidth="@dimen/screen_meta_max_width"
            android:text="待机中"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/screenStage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card">

        <SurfaceView
            android:id="@+id/surfaceScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvScreenHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="20dp"
            android:text="通道已就绪\n点击上方「开始监视」查看 PC 实时画面"
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/btnScreenFullscreen"
            style="@style/ConsoleGhostButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:minHeight="34dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="全屏"
            android:textSize="12sp" />
    </FrameLayout>
</LinearLayout>
