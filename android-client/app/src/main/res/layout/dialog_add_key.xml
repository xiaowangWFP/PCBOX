<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dialog_add_key_title"
            android:textColor="@color/text_primary"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_key_name"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <EditText
            android:id="@+id/etDialogKeyLabel"
            style="@style/ConsoleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:hint="@string/dialog_key_name_hint"
            android:inputType="text"
            android:maxLength="20"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/dialog_key_type"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <Spinner
            android:id="@+id/spinnerDialogKeyType"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/tvDialogTargetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/dialog_key_target"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <EditText
            android:id="@+id/etDialogKeyTarget"
            style="@style/ConsoleInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="monospace"
            android:hint="@string/dialog_key_target_hint"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/dialog_key_color"
            android:textColor="@color/text_secondary"
            android:textSize="12.5sp" />

        <LinearLayout
            android:id="@+id/dialogSwatchRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/swatchSlate"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@color/swatch_slate"
                android:tag="#1E293B" />

            <View
                android:id="@+id/swatchObsidian"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@color/swatch_obsidian"
                android:tag="#0F172A" />

            <View
                android:id="@+id/swatchTeal"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@color/swatch_teal"
                android:tag="#134E4A" />

            <View
                android:id="@+id/swatchCobalt"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@color/swatch_cobalt"
                android:tag="#1E3A8A" />

            <View
                android:id="@+id/swatchCrimson"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@color/swatch_crimson"
                android:tag="#7F1D1D" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDialogError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/status_bad_text"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDialogCancel"
                style="@style/ConsoleGhostButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="@string/dialog_cancel" />

            <TextView
                android:id="@+id/btnDialogSave"
                style="@style/ConsolePrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_save" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
