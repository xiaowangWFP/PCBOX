<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/touchpadRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 整页都是触控区 -->
    <com.phoneconsole.client.ui.TouchpadView
        android:id="@+id/tpTouchpadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 悬浮按键组：按住任意按键可拖动整组 -->
    <com.phoneconsole.client.ui.DraggablePadLayout
        android:id="@+id/tpPadContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:clipChildren="false"
        android:orientation="vertical"
        android:padding="4dp" />

    <!-- 右上角设置入口 -->
    <ImageView
        android:id="@+id/tpSettingsButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_ghost_button"
        android:clickable="true"
        android:contentDescription="@string/touchpad_settings"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_touchpad_settings" />

    <!-- 设置面板 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tpSettingsPanel"
        android:layout_width="300dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/touchpad_settings"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchpad_pad_visible"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tpPadVisibleSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/touchpad_pad_layout"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpLayoutColumn"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="36dp"
                    android:text="@string/touchpad_pad_column"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tpLayoutGrid"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="36dp"
                    android:text="@string/touchpad_pad_grid"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tpLayoutRow"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minHeight="36dp"
                    android:text="@string/touchpad_pad_row"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/touchpad_pad_size"
                android:textColor="@color/text_secondary"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpSizeSmall"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="36dp"
                    android:text="@string/touchpad_pad_small"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tpSizeNormal"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="36dp"
                    android:text="@string/touchpad_pad_normal"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tpSizeLarge"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:minHeight="36dp"
                    android:text="@string/touchpad_pad_large"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/divider_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchpad_volume_scroll"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tpVolumeScrollSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensitivity_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <Spinner
                    android:id="@+id/tpSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/touchpad_volume_hint"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tpPadReset"
                style="@style/ConsoleGhostButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:minHeight="40dp"
                android:text="@string/touchpad_pad_reset"
                android:textSize="12.5sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
