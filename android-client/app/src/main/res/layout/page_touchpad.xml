<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/touchpadRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 整页都是触控区 -->
    <com.phoneconsole.client.ui.TouchpadView
        android:id="@+id/tpTouchpadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 悬浮按键层：每个按键由代码单独添加、单独定位 -->
    <FrameLayout
        android:id="@+id/tpPadLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 调整模式提示条 -->
    <TextView
        android:id="@+id/tpAdjustHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginStart="64dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bg_card"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:text="@string/touchpad_adjust_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- 右上角设置入口 -->
    <ImageView
        android:id="@+id/tpSettingsButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_ghost_button"
        android:clickable="true"
        android:contentDescription="@string/touchpad_settings"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_touchpad_settings" />

    <!-- 设置面板 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tpSettingsPanel"
        android:layout_width="300dp"
        android:layout_height="360dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_card"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/touchpad_settings"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchpad_pad_visible"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tpPadVisibleSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tpAdjustButton"
                style="@style/ConsolePrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:minHeight="40dp"
                android:text="@string/touchpad_adjust_keys"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/touchpad_current_key"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/tpCurrentKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/touchpad_key_none"
                    android:textColor="@color/accent_bright"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SeekBar
                    android:id="@+id/tpSizeSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="170"
                    android:progress="70" />

                <TextView
                    android:id="@+id/tpSizeValue"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="100%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpRenameKey"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="34dp"
                    android:text="@string/touchpad_rename_key"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tpDeleteKey"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="34dp"
                    android:text="@string/touchpad_delete_key"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tpAddKey"
                    style="@style/ConsolePrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:minHeight="34dp"
                    android:text="@string/touchpad_add_key"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="@color/divider_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchpad_haptics"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tpHapticsSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchpad_gestures"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tpGestureHelp"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_ghost_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tpGestureSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchpad_volume_scroll"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tpVolumeScrollSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/touchpad_dpi"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <SeekBar
                    android:id="@+id/tpDpiSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:max="2000"
                    android:progress="800" />

                <TextView
                    android:id="@+id/tpDpiValue"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="1200 DPI"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/touchpad_volume_hint"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/touchpad_gestures_hint"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tpPadReset"
                style="@style/ConsoleGhostButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:minHeight="40dp"
                android:text="@string/touchpad_pad_reset"
                android:textSize="12.5sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 录音提示（上滑取消） -->
    <TextView
        android:id="@+id/tpVoiceHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="78dp"
        android:background="@drawable/bg_voice_panel"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:text="@string/touchpad_voice_cancel_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- 转写结果：点文本或「发送」都会推到 PC -->
    <LinearLayout
        android:id="@+id/tpVoiceResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="78dp"
        android:background="@drawable/bg_voice_panel"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/tpVoiceText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical|start"
            android:hint="@string/touchpad_voice_edit_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:minHeight="34dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tpVoiceSend"
            style="@style/ConsolePrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minHeight="34dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/touchpad_voice_send"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/tpVoiceClose"
            style="@style/ConsoleMiniButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:minHeight="34dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/touchpad_voice_close"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- 按住说话 -->
    <TextView
        android:id="@+id/tpVoiceButton"
        android:layout_width="180dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_voice_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/touchpad_voice_hold"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</FrameLayout>
