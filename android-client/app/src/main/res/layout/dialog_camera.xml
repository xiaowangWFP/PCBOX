<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/camera_dialog_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCameraStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="预览待机"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="228dp"
            android:layout_marginTop="10dp"
            android:background="@color/bg_obsidian"
            android:padding="1dp">

            <com.pedro.library.view.OpenGlView
                android:id="@+id/cameraGlView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCameraMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:text="1280×720 · 30fps · 前摄 · 0°"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- 第 1 行：启停与切换镜头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCameraToggle"
                style="@style/ConsolePrimaryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/camera_start" />

            <TextView
                android:id="@+id/btnCameraSwitch"
                style="@style/ConsoleGhostButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/camera_switch" />
        </LinearLayout>

        <!-- 第 2 行：旋转与闪光灯 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCameraRotate"
                style="@style/ConsoleMiniButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="38dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/camera_rotate" />

            <TextView
                android:id="@+id/btnCameraFlash"
                style="@style/ConsoleMiniButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="38dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/camera_flash" />
        </LinearLayout>

        <!-- 第 3 行：水平镜像与垂直翻转 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCameraMirrorH"
                style="@style/ConsoleMiniButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="38dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/camera_mirror_h" />

            <TextView
                android:id="@+id/btnCameraMirrorV"
                style="@style/ConsoleMiniButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="38dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/camera_mirror_v" />
        </LinearLayout>

        <!-- 第 4 行：微信/会议自动唤醒开关与画质分辨率 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCameraAutoDemand"
                style="@style/ConsoleMiniButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="38dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/camera_auto_demand" />

            <TextView
                android:id="@+id/btnCameraRes"
                style="@style/ConsoleMiniButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="38dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/camera_res" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/camera_bg_hint"
            android:textColor="@color/text_muted"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/btnCameraClose"
            style="@style/ConsoleGhostButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/camera_close" />
    </LinearLayout>
</ScrollView>
