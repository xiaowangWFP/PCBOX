<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_keycap"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/keycap_min_height">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/keycap_min_height"
        android:orientation="vertical"
        android:padding="@dimen/keycap_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivKeyIcon"
                android:layout_width="@dimen/keycap_icon_box"
                android:layout_height="@dimen/keycap_icon_box"
                android:background="@drawable/bg_icon_badge"
                android:contentDescription="@null"
                android:padding="6dp"
                android:src="@drawable/ic_key_default" />

            <TextView
                android:id="@+id/tvKeyHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:text="快捷动作"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvKeyLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="按键名称"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 长按连发进度条 -->
    <View
        android:id="@+id/viewHoldBar"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:background="@color/accent_bright" />

    <!-- 编辑模式移除角标 -->
    <ImageView
        android:id="@+id/btnDeleteKey"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_delete_badge"
        android:contentDescription="移除按键"
        android:padding="6dp"
        android:src="@drawable/ic_close"
        android:visibility="gone" />
</FrameLayout>
