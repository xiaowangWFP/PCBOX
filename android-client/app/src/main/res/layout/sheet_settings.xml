<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheetSettingsBackdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#88000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/sheetSettingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <View
                android:id="@+id/sheetSettingsHandle"
                android:layout_width="38dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSettingsSheetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="连接与通道设置"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCloseSettingsSheet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:text="完成"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSettingsChanLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="已保存通道"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinnerChannels"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="120dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <TextView
                    android:id="@+id/btnAddChannel"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:minHeight="42dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="添加" />

                <TextView
                    android:id="@+id/btnDeleteChannel"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:minHeight="42dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="删除" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.5"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSettingsHostLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PC 地址（USB 用 127.0.0.1）"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etServerHost"
                        style="@style/ConsoleInput"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:hint="127.0.0.1"
                        android:inputType="textUri"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.7"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvSettingsPortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="端口"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/etServerPort"
                        style="@style/ConsoleInput"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:hint="8500"
                        android:inputType="number"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReconnect"
                    style="@style/ConsolePrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="保存并重连" />

                <TextView
                    android:id="@+id/btnScanQr"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.8"
                    android:text="扫码配对" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSessionDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:padding="12dp"
                android:text="尚未连接"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvUsbUnlockSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="唤醒与无线设置"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/usbUnlockCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvKeepScreenOnLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="应用运行期间保持屏幕常亮"
                        android:textSize="12.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchKeepScreenOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPcAutoUnlockLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="连接 / 启动时自动亮屏解锁并打开应用"
                        android:textSize="12.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPcAutoUnlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etPcUnlockPwd"
                        style="@style/ConsoleInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:hint="锁屏密码（留空仅亮屏上滑）"
                        android:inputType="textPassword"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/btnSaveUsbUnlock"
                        style="@style/ConsolePrimaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginEnd="6dp"
                        android:minHeight="40dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="保存" />

                    <TextView
                        android:id="@+id/btnClearUsbUnlockPwd"
                        style="@style/ConsoleMiniButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minHeight="40dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="清空" />
                </LinearLayout>

                <View
                    android:id="@+id/wirelessDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPcWirelessUnlockLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="无线调试 (ADB over Wi-Fi) 自动连接"
                        android:textSize="12.5sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPcWirelessUnlock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="34dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etPcWirelessEndpoint"
                    style="@style/ConsoleInput"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:hint="无线调试 IP:端口（如 10.26.3.135:33007）"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnTestUsbUnlock"
                        style="@style/ConsoleMiniButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:minHeight="38dp"
                        android:text="测试解锁启动" />

                    <TextView
                        android:id="@+id/btnOpenWirelessSettings"
                        style="@style/ConsoleMiniButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.1"
                        android:minHeight="38dp"
                        android:text="开发者 / 无线调试" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvUsbUnlockStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="连接 PC 后可同步；小米手机需在开发者选项开启「USB 调试（安全设置）」与「无线调试」"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

