<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/controlLandscapeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_padding_h"
    android:paddingTop="@dimen/page_padding_v"
    android:paddingEnd="@dimen/page_padding_h"
    android:paddingBottom="@dimen/page_padding_v">

    <!-- 横屏紧凑顶部栏：左侧标题 + 中部面板分段切换 + 右侧编辑/新增按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDeckTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="通用控制"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeckMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="9 个按键 · 4 套场景"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <FrameLayout
                android:id="@+id/deckTabWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segmented"
                android:padding="3dp">

                <View
                    android:id="@+id/deckTabThumb"
                    android:layout_width="64dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_segmented_thumb" />

                <LinearLayout
                    android:id="@+id/deckTabContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </FrameLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/btnToggleEditDeck"
            style="@style/ConsoleGhostButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="8dp"
            android:minHeight="34dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/ctrl_manage_keys"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnAddCustomKey"
            style="@style/ConsolePrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:minHeight="34dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/ctrl_add_key"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 横屏双栏主体：左按键甲板 (1.25) 与 右实用工具舱 (0.9) 并排 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏：音频媒体控制条 + 触控按键甲板（独立滚动） -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:layout_weight="1.25"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/audioDockCard"
                    style="@style/ConsoleCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSpeakerMute"
                            style="@style/ConsoleGhostButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:minHeight="34dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/ctrl_speaker"
                            android:textSize="11.5sp" />

                        <SeekBar
                            android:id="@+id/seekVolume"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="64"
                            android:progressDrawable="@drawable/seekbar_volume"
                            android:splitTrack="false"
                            android:thumb="@drawable/seekbar_thumb" />

                        <TextView
                            android:id="@+id/tvVolumeValue"
                            android:layout_width="34dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:fontFamily="monospace"
                            android:gravity="end"
                            android:text="64%"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnMicMute"
                            style="@style/ConsoleGhostButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:minHeight="34dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/ctrl_mic"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="7dp"
                        android:background="@color/divider_line" />

                    <!-- 单行紧凑媒体与系统快捷按钮 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnQuickSleep"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="32dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/ctrl_sleep"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnQuickShot"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="0.85"
                            android:minHeight="32dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/ctrl_screenshot"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnQuickDesktop"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="0.85"
                            android:minHeight="32dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/ctrl_desktop"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnQuickLock"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="0.85"
                            android:minHeight="32dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/ctrl_lock"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDeckButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- 右栏：实用工具舱（快捷输入 / 触控板 / 历史，独立滚动） -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/companionCard"
                style="@style/ConsoleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/companionTabWrap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_segmented"
                    android:padding="3dp">

                    <View
                        android:id="@+id/companionTabThumb"
                        android:layout_width="76dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_segmented_thumb" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/companionTabInput"
                            style="@style/ConsoleSegmentedTab"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:minHeight="30dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/companion_tab_input"
                            android:textColor="@color/text_on_accent"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/companionTabTouchpad"
                            style="@style/ConsoleSegmentedTab"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:minHeight="30dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/companion_tab_touchpad"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/companionTabHistory"
                            style="@style/ConsoleSegmentedTab"
                            android:layout_width="0dp"
                            android:layout_height="30dp"
                            android:layout_weight="1"
                            android:minHeight="30dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/companion_tab_history"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- 快捷输入 -->
                <LinearLayout
                    android:id="@+id/paneQuickInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/etRemoteText"
                        style="@style/ConsoleInput"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:hint="@string/companion_input_hint"
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="36dp"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSendTextOnly"
                            style="@style/ConsoleGhostButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:text="@string/companion_send_only"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnSendTextEnter"
                            style="@style/ConsolePrimaryButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1.35"
                            android:minHeight="34dp"
                            android:text="@string/companion_send_enter"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnHotkeyCopy"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:text="复制"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/btnHotkeyPaste"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:text="粘贴"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnHotkeyUndo"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:text="撤销"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/btnHotkeySelectAll"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:text="全选"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnHotkeyAltTab"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:text="切窗口"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/btnHotkeyClose"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:minHeight="34dp"
                            android:text="关窗口"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 触控板（一屏完整可见） -->
                <LinearLayout
                    android:id="@+id/paneTouchpad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.phoneconsole.client.ui.TouchpadView
                        android:id="@+id/touchpadView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touchpad_height" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnMouseLeft"
                            style="@style/ConsoleGhostButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1.2"
                            android:minHeight="34dp"
                            android:text="@string/mouse_left"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnMouseMiddle"
                            style="@style/ConsoleGhostButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="0.85"
                            android:minHeight="34dp"
                            android:text="@string/mouse_middle"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnMouseRight"
                            style="@style/ConsoleGhostButton"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1.2"
                            android:minHeight="34dp"
                            android:text="@string/mouse_right"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnScrollUp"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginEnd="5dp"
                            android:minHeight="32dp"
                            android:text="@string/scroll_up" />

                        <TextView
                            android:id="@+id/btnScrollDown"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:minHeight="32dp"
                            android:text="@string/scroll_down" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <Spinner
                            android:id="@+id/spinnerTouchpadSens"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_input"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 历史记录 -->
                <LinearLayout
                    android:id="@+id/paneHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/history_title"
                            android:textColor="@color/text_secondary"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/btnClearHistory"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:minHeight="30dp"
                            android:text="@string/history_clear"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/historyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
