<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <!-- 左侧预览区 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="236dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="0.95"
            android:background="@color/bg_obsidian"
            android:padding="1dp">

            <com.pedro.library.view.OpenGlView
                android:id="@+id/cameraGlView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <!-- 右侧全功能操作区 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/camera_dialog_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCameraStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:paddingStart="9dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="3dp"
                    android:text="预览待机"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCameraMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:text="1280×720 · 30fps · 前摄 · 0°"
                android:textColor="@color/text_secondary"
                android:textSize="11.5sp" />

            <!-- 第 1 行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCameraToggle"
                    style="@style/ConsolePrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="38dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/camera_start"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnCameraSwitch"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="38dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/camera_switch"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 第 2 行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCameraRotate"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/camera_rotate"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/btnCameraFlash"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/camera_flash"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 第 3 行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCameraMirrorH"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/camera_mirror_h"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/btnCameraMirrorV"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/camera_mirror_v"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 第 4 行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnCameraAutoDemand"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/camera_auto_demand"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/btnCameraRes"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="36dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/camera_res"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnCameraClose"
                style="@style/ConsoleGhostButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="36dp"
                android:text="@string/camera_close"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
