<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="@dimen/page_padding_h"
    android:paddingTop="@dimen/page_padding_v"
    android:paddingEnd="@dimen/page_padding_h"
    android:paddingBottom="12dp">

    <!-- 左：触控移动区，占满高度 -->
    <LinearLayout
        style="@style/ConsoleCard"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:layout_weight="1.35"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/touchpad_title"
            android:textColor="@color/text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <com.phoneconsole.client.ui.TouchpadView
            android:id="@+id/tpTouchpadView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 右：按键与设置 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            style="@style/ConsoleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpMouseLeft"
                    style="@style/ConsolePrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/mouse_left"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tpMouseMiddle"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/mouse_middle"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tpMouseRight"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/mouse_right"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tpScrollUp"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/scroll_up"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tpScrollDown"
                    style="@style/ConsoleGhostButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:minHeight="52dp"
                    android:text="@string/scroll_down"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/ConsoleCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensitivity_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />

                <Spinner
                    android:id="@+id/tpSensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/touchpad_volume_scroll"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/tpVolumeScrollSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/touchpad_volume_hint"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
