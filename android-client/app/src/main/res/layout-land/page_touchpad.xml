<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/touchpadRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <!-- 横屏顶栏 -->
    <LinearLayout
        android:id="@+id/tpTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tpModeGroup"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnModeTouchOnly"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="纯触控"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnModeScreenSplit"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="边看边控"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerMonitors"
            android:layout_width="180dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <Space
            android:id="@+id/tpBarSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnToggleHotkeyBar"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="快捷键"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tpSettingsButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:contentDescription="@string/touchpad_settings"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_touchpad_settings" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/tpQuickHotkeyScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/tpQuickHotkeyRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 横屏分栏体：左屏幕监视 + 右触控板 -->
    <LinearLayout
        android:id="@+id/tpSplitContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/screenStage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1.05"
            android:visibility="gone">

            <SurfaceView
                android:id="@+id/surfaceScreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvScreenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="16dp"
                android:text="点左上角「开始监视」查看 PC 画面"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnToggleStream"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="开始监视"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnScreenFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="全屏"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvScreenMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="待机中"
                android:textSize="11sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tpTouchArea"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.phoneconsole.client.ui.TouchpadView
                android:id="@+id/tpTouchpadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/tpPadLayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tpAdjustHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="@string/touchpad_adjust_hint"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/tpSettingsPanel"
                android:layout_width="300dp"
                android:layout_height="match_parent"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="2dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/touchpad_settings"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_pad_visible"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/tpPadVisibleSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tpAdjustButton"
                        style="@style/ConsolePrimaryButton"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="6dp"
                        android:minHeight="38dp"
                        android:text="@string/touchpad_adjust_keys"
                        android:textSize="12.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/touchpad_current_key"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tpCurrentKey"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/touchpad_key_none"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <SeekBar
                            android:id="@+id/tpSizeSeek"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:max="170"
                            android:progress="70" />

                        <TextView
                            android:id="@+id/tpSizeValue"
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="100%"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tpRenameKey"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="32dp"
                            android:text="@string/touchpad_rename_key"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tpDeleteKey"
                            style="@style/ConsoleMiniButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:minHeight="32dp"
                            android:text="@string/touchpad_delete_key"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/tpAddKey"
                            style="@style/ConsolePrimaryButton"
                            android:layout_width="0dp"
                            android:layout_height="32dp"
                            android:layout_weight="1"
                            android:minHeight="32dp"
                            android:text="@string/touchpad_add_key"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="@color/divider_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_haptics"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/tpHapticsSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_gestures"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tpGestureHelp"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/bg_ghost_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:text="?"
                            android:textSize="11.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/tpGestureSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/touchpad_volume_scroll"
                            android:textSize="12.5sp" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/tpVolumeScrollSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="34dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/touchpad_dpi"
                            android:textSize="12sp" />

                        <SeekBar
                            android:id="@+id/tpDpiSeek"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:max="2000"
                            android:progress="800" />

                        <TextView
                            android:id="@+id/tpDpiValue"
                            android:layout_width="70dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="1200 DPI"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tpPadReset"
                        style="@style/ConsoleGhostButton"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:minHeight="36dp"
                        android:text="@string/touchpad_pad_reset"
                        android:textSize="12sp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/tpVoiceHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="66dp"
                android:background="@drawable/bg_voice_panel"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/touchpad_voice_cancel_hint"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/tpVoiceResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="66dp"
                android:background="@drawable/bg_voice_panel"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/tpVoiceText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:gravity="center_vertical|start"
                    android:hint="@string/touchpad_voice_edit_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="2"
                    android:minHeight="32dp"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tpVoiceSend"
                    style="@style/ConsolePrimaryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:minHeight="32dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/touchpad_voice_send"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tpVoiceClose"
                    style="@style/ConsoleMiniButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:minHeight="32dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/touchpad_voice_close"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tpVoiceButton"
                android:layout_width="160dp"
                android:layout_height="40dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_voice_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/touchpad_voice_hold"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

